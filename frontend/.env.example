# 이 파일을 복사해서 .env 로 저장하고, 아래 값들을 실제 값으로 채워주세요.
# .env는 git에 올라가지 않아요(.gitignore에 이미 포함되어 있어요).

# 백엔드 팀원한테 받은 API 주소 (아직 없으면 비워두거나 로컬 주소로 둬도 됨)
VITE_API_BASE_URL=http://localhost:8000

# Supabase 프로젝트 설정 > API 메뉴에서 확인 가능
# 이 두 값이 비어있으면 앱이 자동으로 "가짜 로그인" 모드로 동작해서, Supabase 세팅 전에도 화면 테스트는 가능해요.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
